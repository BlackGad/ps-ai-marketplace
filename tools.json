{
  "schemaVersion": 1,
  "bootstrap": {
    "windows": {
      "wingetId": "Microsoft.PowerShell",
      "portableCommand": "pwsh.exe",
      "download": {
        "zip": {
          "kind": "zip",
          "resolver": "release-assets",
          "metadataUrl": "https://api.github.com/repos/PowerShell/PowerShell/releases/latest",
          "assetPattern": "^PowerShell-[\\d.]+-win-x64\\.zip$",
          "verification": "asset-digest",
          "arguments": [],
          "pathFolder": ""
        }
      }
    }
  },
  "tools": [
    {
      "id": "claude",
      "command": "claude",
      "configEnv": "CLAUDE_CONFIG_DIR",
      "plugin": {
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "install": [
          "plugin",
          "install",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "update",
          "ps-ai-marketplace"
        ],
        "update": [
          "plugin",
          "update",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list"
        ],
        "list": [
          "plugin",
          "list",
          "--json"
        ],
        "listing": {
          "format": "json",
          "idField": "id",
          "enabledField": "enabled"
        }
      },
      "hooks": {
        "status": "active",
        "hint": ""
      },
      "installHint": "irm https://claude.ai/install.ps1 | iex"
    },
    {
      "id": "codex",
      "command": "codex",
      "configEnv": "CODEX_HOME",
      "plugin": {
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "install": [
          "plugin",
          "add",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "upgrade"
        ],
        "update": [
          "plugin",
          "add",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list"
        ],
        "list": [
          "plugin",
          "list"
        ],
        "listing": {
          "format": "lines",
          "rejectPattern": "not installed|disabled"
        }
      },
      "hooks": {
        "status": "trust once with /hooks",
        "hint": "Codex: approve the ps-ai hooks once with /hooks in a Codex session."
      },
      "installHint": "npm install -g @openai/codex"
    },
    {
      "id": "copilot",
      "command": "copilot",
      "configEnv": "COPILOT_HOME",
      "plugin": {
        "marketplaceAdd": [
          "plugin",
          "marketplace",
          "add",
          "{source}"
        ],
        "install": [
          "plugin",
          "install",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceUpdate": [
          "plugin",
          "marketplace",
          "update",
          "ps-ai-marketplace"
        ],
        "update": [
          "plugin",
          "update",
          "ps-ai@ps-ai-marketplace"
        ],
        "marketplaceList": [
          "plugin",
          "marketplace",
          "list"
        ],
        "list": [
          "plugin",
          "list"
        ],
        "listing": {
          "format": "lines",
          "rejectPattern": "not installed|disabled"
        }
      },
      "hooks": {
        "status": "unknown",
        "hint": ""
      },
      "installHint": "npm install -g @github/copilot"
    }
  ]
}
