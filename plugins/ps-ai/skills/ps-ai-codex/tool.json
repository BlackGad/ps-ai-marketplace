{
  "schemaVersion": 1,
  "id": "codex", "command": "codex", "configEnv": "CODEX_HOME",
  "foundry": {"deploymentPrefix": "gpt", "aliases": []},
  "overseerArgs": [],
  "plugin": {
    "defaultConfigDir": "~/.codex",
    "installedRoot": "plugins/cache/ps-ai-marketplace/ps-ai",
    "cacheDir": "plugins/cache/ps-ai-marketplace",
    "marketplaceAdd": ["plugin", "marketplace", "add", "{source}"],
    "uninstall": ["plugin", "remove", "ps-ai@ps-ai-marketplace"],
    "marketplaceRemove": ["plugin", "marketplace", "remove", "ps-ai-marketplace"],
    "install": ["plugin", "add", "ps-ai@ps-ai-marketplace"],
    "marketplaceUpdate": ["plugin", "marketplace", "upgrade"],
    "update": ["plugin", "add", "ps-ai@ps-ai-marketplace"],
    "marketplaceList": ["plugin", "marketplace", "list", "--json"],
    "marketplaceListing": {"format": "json", "collectionField": "marketplaces", "nameField": "name", "rootField": "root"},
    "list": ["plugin", "list"],
    "listing": {"format": "lines", "rejectPattern": "not installed|disabled"}
  },
  "hooks": {"status": "trust once with /hooks", "hint": "Codex: approve the ps-ai hooks once with /hooks in a Codex session."},
  "install": {
    "check": ["codex", "--version"], "hint": "npm install -g @openai/codex",
    "windows": {
      "wingetId": "OpenAI.Codex", "portableCommand": "codex.exe",
      "download": {
        "msi": {"kind": "script", "url": "https://chatgpt.com/codex/install.ps1", "verification": "vendor"},
        "zip": {"kind": "script", "url": "https://chatgpt.com/codex/install.ps1", "verification": "vendor"}
      }
    },
    "macos": {"needs": ["node"], "commands": [["npm", "install", "-g", "@openai/codex"]], "docs": ""},
    "linux": {"needs": ["node"], "commands": [["npm", "install", "-g", "@openai/codex"]], "docs": ""}
  }
}
