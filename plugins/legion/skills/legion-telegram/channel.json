{
  "schemaVersion": 1,
  "id": "telegram",
  "launch": {
    "claude": ["--channels", "plugin:telegram@claude-plugins-official"],
    "codex": []
  },
  "state": {
    "claude": {
      "variable": "TELEGRAM_STATE_DIR",
      "folder": "channels/telegram",
      "remove": ["TELEGRAM_BOT_TOKEN"],
      "tokenFile": ".env",
      "setup": "run /telegram:configure in that session"
    },
    "codex": {
      "variable": "TELEGRAM_STATE_DIR",
      "folder": "channels/telegram",
      "remove": ["TELEGRAM_BOT_TOKEN"],
      "tokenFile": ".env",
      "setup": "pair the bot on Claude first"
    }
  },
  "ready": {
    "command": "bun",
    "pluginFolder": {
      "claude": "plugins/cache/claude-plugins-official/telegram"
    }
  }
}
