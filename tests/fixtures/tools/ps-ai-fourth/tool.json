{
  "schemaVersion": 1,
  "id": "fourth",
  "command": "fourth-cli",
  "configEnv": "FOURTH_HOME",
  "foundry": {
    "deploymentPrefix": "model[1]",
    "aliases": [
      "alpha"
    ]
  },
  "overseerArgs": [
    "--interactive",
    "space value"
  ],
  "plugin": {
    "marketplaceAdd": [
      "plugin",
      "marketplace",
      "add",
      "{source}"
    ],
    "install": [
      "plugin",
      "install",
      "ps-ai@ps-ai-marketplace"
    ],
    "marketplaceList": [
      "plugin",
      "marketplace",
      "list"
    ],
    "list": [
      "plugin",
      "list"
    ],
    "listing": {
      "format": "lines",
      "rejectPattern": "not installed|disabled"
    }
  },
  "hooks": {
    "status": "unknown",
    "hint": ""
  },
  "install": {
    "check": [
      "fourth-cli",
      "--version"
    ],
    "hint": "Use the fixture installer",
    "windows": {
      "wingetId": "Example.Fourth",
      "portableCommand": "fourth-v*/fourth-cli.exe",
      "download": {
        "msi": {
          "kind": "msi",
          "resolver": "release-assets",
          "metadataUrl": "https://fixture.test/releases/latest",
          "assetPattern": "^fourth-x64\\.msi$",
          "verification": "asset-digest",
          "arguments": [
            "/qn",
            "/norestart"
          ]
        },
        "zip": {
          "kind": "zip",
          "resolver": "release-assets",
          "metadataUrl": "https://fixture.test/releases/latest",
          "assetPattern": "^fourth-x64\\.zip$",
          "verification": "asset-digest",
          "arguments": [],
          "pathFolder": ""
        }
      }
    },
    "macos": {
      "needs": [],
      "commands": [],
      "docs": "https://fixture.test/install"
    },
    "linux": {
      "needs": [],
      "commands": [],
      "docs": "https://fixture.test/install"
    }
  }
}
