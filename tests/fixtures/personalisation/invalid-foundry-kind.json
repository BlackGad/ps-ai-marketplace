{
  "$schema": "<plugin>/schemas/personalisation.schema.json",
  "schemaVersion": 1,
  "agents": [
    {
      "id": "claude",
      "tool": "claude",
      "configDir": "~/.agents/accounts/claude"
    },
    {
      "id": "claude-b",
      "tool": "claude",
      "configDir": "~/.claude-b"
    },
    {
      "id": "codex-a",
      "tool": "codex",
      "configDir": "~/.codex"
    },
    {
      "id": "codex-b",
      "tool": "codex",
      "configDir": "~/.agents/accounts/codex-b"
    },
    {
      "id": "copilot",
      "tool": "copilot",
      "configDir": "~/.agents/accounts/copilot"
    },
    {
      "id": "claude-dev",
      "tool": "claude",
      "configDir": "~/.agents/accounts/claude-dev",
      "provider": {
        "kind": "bedrock",
        "endpoint": "https://res-a.cognitiveservices.azure.com",
        "default": "claude-opus-x",
        "deployments": [
          {
            "name": "claude-opus-x",
            "model": "claude-opus-x",
            "alias": "opus"
          },
          {
            "name": "claude-sonnet-x",
            "model": "claude-sonnet-x",
            "alias": "sonnet"
          }
        ]
      }
    }
  ],
  "channels": []
}
