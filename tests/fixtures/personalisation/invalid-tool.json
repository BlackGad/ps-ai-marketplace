{
  "$schema": "<plugin>/schemas/personalisation.schema.json",
  "schemaVersion": 1,
  "communication": {
    "language": "simple-english",
    "questions": "one-at-a-time",
    "channels": {
      "telegram-main": {
        "kind": "telegram",
        "target": "123456789",
        "format": "markdownv2",
        "tone": "business",
        "launch": {
          "claude": [
            "--channels",
            "plugin:telegram@claude-plugins-official"
          ]
        }
      }
    }
  },
  "agents": [
    {
      "id": "claude",
      "tool": "other",
      "command": "claude",
      "configDir": "default",
      "roles": [
        "overseer"
      ],
      "care": "high",
      "launch": {
        "args": []
      }
    },
    {
      "id": "claude-b",
      "tool": "claude",
      "command": "~/bin/claude-b",
      "configDir": "~/.claude-b",
      "roles": [
        "legion",
        "reviewer"
      ],
      "models": {
        "legion": "opus",
        "reviewer": "opus"
      }
    },
    {
      "id": "codex-a",
      "tool": "codex",
      "command": "~/bin/codex-a",
      "configDir": "~/.codex",
      "roles": [
        "legion",
        "reviewer"
      ],
      "models": {
        "legion": "gpt-6-sol",
        "reviewer": "gpt-6-astra"
      }
    },
    {
      "id": "codex-b",
      "tool": "codex",
      "command": "~/bin/codex-b",
      "roles": [
        "legion"
      ],
      "models": {
        "legion": "gpt-6-sol"
      }
    },
    {
      "id": "copilot",
      "tool": "copilot",
      "command": "copilot",
      "configDir": "default",
      "roles": [
        "reviewer"
      ],
      "models": {
        "reviewer": "gemini-4-argon"
      },
      "cost": "paid"
    }
  ],
  "routing": {
    "implement": [
      "codex-a",
      "codex-b",
      "claude-b"
    ],
    "review": [
      "codex-a",
      "claude-b",
      "copilot"
    ],
    "mechanical": [
      "claude-b"
    ],
    "neverModels": [
      "grok-4.7"
    ],
    "rules": [
      "astra only for milestone review, never implementation",
      "sol never as reviewer"
    ]
  },
  "knowledge": {
    "backend": "llm-wiki",
    "hub": "~/.agents/knowledge"
  },
  "projects": {
    "my-project": {
      "label": "example",
      "notify": [
        "telegram-main"
      ],
      "launch": {},
      "routing": {}
    }
  },
  "default": {
    "notify": []
  }
}
